# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
TIMEZONE=Europe/London
APP_PUBLIC_URL=http://localhost:3000

# Postgres (hosted or local — not bundled with this repo)
DATABASE_URL=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Slack (add OAuth scope files:read so DMs can include image URLs the bot can download)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_USER_ID=

# Notion — tasks-only: set NOTION_TASKS_DB_ID to your DB id; leave NOTION_PROJECTS_DB_ID empty.
# Status column is usually single-select → NOTION_STATUS_PROPERTY_KIND=select
NOTION_TOKEN=
NOTION_PROJECTS_DB_ID=
NOTION_TASKS_DB_ID=
NOTION_LOGS_DB_ID=
NOTION_STATUS_PROPERTY_KIND=select

# Google (single OAuth app for Gmail + Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_USER_EMAIL=

# GitHub
GITHUB_PAT=
GITHUB_USERNAME=
# Comma-separated owner/repo pairs for the daily brief (and optional defaults for GitHub tools)
GITHUB_BRIEF_REPOS=

# Granola (optional)
GRANOLA_API_BASE=https://api.granola.ai
GRANOLA_API_KEY=

# Cron auth
CRON_SECRET=
