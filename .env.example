# Server
PORT=8000
NODE_ENV=development
LOG_LEVEL=info
TIMEZONE=Europe/London
APP_PUBLIC_URL=http://localhost:8000
# Override default prompts/system.md if needed (absolute or relative to cwd)
# SYSTEM_PROMPT_PATH=prompts/system.md

# Postgres — docker compose overrides DATABASE_URL to the `db` service.
# You do not need a hosted database. Set a password for production:
POSTGRES_USER=cto
POSTGRES_PASSWORD=cto
POSTGRES_DB=cto_agent
# Used only when running the API on the host (not via compose):
DATABASE_URL=postgresql://cto:cto@localhost:5432/cto_agent

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Slack — scopes: chat:write (messages + scheduled DMs), files:read (DM images), users:read (DMs)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_USER_ID=

# Notion — tasks-only: set NOTION_TASKS_DB_ID to your DB id; leave NOTION_PROJECTS_DB_ID empty.
# Status column is usually single-select → NOTION_STATUS_PROPERTY_KIND=select
NOTION_TOKEN=
NOTION_PROJECTS_DB_ID=
NOTION_TASKS_DB_ID=
NOTION_LOGS_DB_ID=
# NOTION_STATUS_PROPERTY_KIND=select

# Google OAuth (Gmail + Calendar). Connect from Slack: "connect google"
# Authorized redirect URI: {APP_PUBLIC_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Used as a login hint and as a one-time fallback until you click Connect Google.
GOOGLE_USER_EMAIL=
# Optional legacy fallback. Prefer the Slack connect link; tokens are stored in Postgres.
GOOGLE_REFRESH_TOKEN=

# GitHub — PAT needs repo (classic) or All repositories (fine-grained) for private + org access
GITHUB_PAT=
GITHUB_USERNAME=

# Granola (optional)
GRANOLA_API_BASE=https://api.granola.ai
GRANOLA_API_KEY=

# Cron auth
CRON_SECRET=
