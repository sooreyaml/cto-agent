# Server
PORT=8000
NODE_ENV=development
LOG_LEVEL=info
TIMEZONE=Europe/London
APP_PUBLIC_URL=http://localhost:8000
# Override default prompts/system.md if needed (absolute or relative to cwd)
# SYSTEM_PROMPT_PATH=prompts/system.md

# Postgres — docker compose overrides DATABASE_URL to the `db` service.
# You do not need a hosted database. Set a password for production:
POSTGRES_USER=cto
POSTGRES_PASSWORD=cto
POSTGRES_DB=cto_agent
# Used only when running the API on the host (not via compose):
DATABASE_URL=postgresql://cto:cto@localhost:5432/cto_agent

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Discord — required. Developer Portal → Bot → enable MESSAGE CONTENT INTENT.
# DM the bot or @mention it. Only DISCORD_USER_ID is answered.
DISCORD_BOT_TOKEN=
DISCORD_USER_ID=

# Google OAuth (Gmail + Calendar). Connect from Discord: "connect google"
# Authorized redirect URI: {APP_PUBLIC_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Used as a login hint and as a one-time fallback until you click Connect Google.
GOOGLE_USER_EMAIL=
# Optional legacy fallback. Prefer the Discord connect link; tokens are stored in Postgres.
GOOGLE_REFRESH_TOKEN=

# GitHub OAuth (same idea as Google). Connect from Discord: "connect github"
# Authorization callback URL: {APP_PUBLIC_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional leftover. Prefer Discord connect; the user token is stored in Postgres.
GITHUB_PAT=
GITHUB_USERNAME=

# Granola — say "connect granola" in Discord (browser OAuth, no API key, no extra env).
# Optional leftover REST key if you still use the public API instead of MCP.
GRANOLA_API_BASE=https://api.granola.ai
GRANOLA_API_KEY=

# Cron auth
CRON_SECRET=
